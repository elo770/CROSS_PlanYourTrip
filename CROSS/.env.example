# 复制为 .env 后填入真实值（勿将 .env 提交到仓库）
# 所有 VITE_* 变量都会被打包到浏览器；不要在这里填写 DeepSeek、数据库或服务端私钥。

# 地图与 API
VITE_AMAP_KEY=
VITE_MAPQUEST_KEY=
VITE_MAPTILER_KEY=
# 部署时填写服务端地址，例如 https://your-api.example.com/api；本地开发可留空。
VITE_API_BASE_URL=

# Firebase Web 配置（仅在需要 Firestore 同步路线与预算时填写）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
